@model IEnumerable<Yash_Gems___Jewelleries.Models.Item>
@{
    ViewData["Title"] = "Products";
    int totalPages = ViewBag.TotalPages ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
}

<!-- Start Container Fluid -->
<div class="container-fluid">
     @Html.AntiForgeryToken()
     <partial name="_Notifications" />
     <div class="row">
          <div class="col-xl-12">
               <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center gap-1">
                    <form asp-action="Index" method="get">
                    
                         <h4 class="card-title flex-grow-1">All Product List @(ViewBag.TotalItems != null ? $"({ViewBag.TotalItems})" : "")</h4>

                         <a href="@Url.Action("Add", "Item", new { area = "Admin" })" class="btn btn-sm btn-primary">
                              Add Product
                         </a>

                         <div class="dropdown">
                              <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light" data-bs-toggle="dropdown" aria-expanded="false">
                                   Category
                              </a>
                              <!-- Category Dropdown -->
                         </div>
                         <div class="dropdown">
                              <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light" data-bs-toggle="dropdown" aria-expanded="false">
                                   Status
                              </a>
                              <div class="dropdown-menu dropdown-menu-end">
                                   <!-- item-->
                                   <a href="#!" class="dropdown-item">All</a>
                                   <!-- item-->
                                   <a href="#!" class="dropdown-item">Active</a>
                                   <!-- item-->
                                   <a href="#!" class="dropdown-item">Inactive</a>
                              </div>
                         </div>
                    </form>
                    </div>
                     <!-- Filter Panel -->
                     <div class="card-body border-bottom">
                          <form asp-action="Index" method="get" class="row g-3">
                               <div class="col-md-3">
                                    <label class="form-label">Search</label>
                                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by Style Code or Name">
                               </div>
                               <div class="col-md-2">
                                    <label class="form-label">Brand</label>
                                    <select name="brandId" class="form-select">
                                         <option value="">All Brands</option>
                                         @if (ViewBag.Brands != null)
                                         {
                                            foreach (var brand in (IEnumerable<Yash_Gems___Jewelleries.Models.Masters.Brand>)ViewBag.Brands)
                                            {
                                                <option value="@brand.BrandId" selected="@(ViewBag.BrandId != null && (int)ViewBag.BrandId == brand.BrandId)">@brand.BrandType</option>
                                            }
                                         }
                                    </select>
                               </div>
                               <div class="col-md-2">
                                    <label class="form-label">Category</label>
                                    <select name="categoryId" class="form-select">
                                         <option value="">All Categories</option>
                                         @if (ViewBag.Categories != null)
                                         {
                                            foreach (var category in (IEnumerable<Yash_Gems___Jewelleries.Models.Masters.Category>)ViewBag.Categories)
                                            {
                                                <option value="@category.CategoryId" selected="@(ViewBag.CategoryId != null && (int)ViewBag.CategoryId == category.CategoryId)">@category.CategoryName</option>
                                            }
                                         }
                                    </select>
                               </div>
                               <div class="col-md-2">
                                    <label class="form-label">Status</label>
                                    <select name="isActive" class="form-select">
                                         <option value="">All Status</option>
                                         <option value="true" selected="@((bool?)ViewBag.IsActive == true)">Active</option>
                                         <option value="false" selected="@((bool?)ViewBag.IsActive == false)">Inactive</option>
                                    </select>
                               </div>
                               <div class="col-md-3 d-flex align-items-end gap-2">
                                    <button type="submit" class="btn btn-primary"><i class="bx bx-filter-alt me-1"></i>Filter</button>
                                     <a href="@Url.Action("Index", "Item", new { area = "Admin" })" class="btn btn-secondary"><i class="bx bx-reset me-1"></i>Reset</a>
                               </div>
                          </form>
                     </div>
                    <div>
                         <div class="table-responsive">
                              <table class="table align-middle mb-0 table-hover table-centered">
                                   <thead class="bg-light-subtle">
                                        <tr>
                                             <th>Product Name & Type</th>
                                             <th>Price</th>
                                             <th>Stock</th>
                                             <th>Category</th>
                                             <th>Rating</th>
                                             <th>Action</th>
                                        </tr>
                                   </thead>
                                   <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                             @foreach (var item in Model)
                                             {
                                                  <tr>
                                                       <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                 <div class="rounded bg-light avatar-md d-flex align-items-center justify-content-center">
                                                                      <img src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/uploads/default" : item.PrimaryImageUrl)" alt="@item.ItemName">
                                                                 </div>
                                                                 <div>
                                                                      <a href="@Url.Action("Detail", "Item", new { area = "Admin", id = item.StyleCode })" class="text-dark fw-medium fs-15">@item.ItemName</a>
                                                                      <p class="text-muted mb-0 mt-1 fs-13"><span>Type : </span>@item.ProductType?.ProductTypeName</p>
                                                                 </div>
                                                            </div>
                                                       </td>
                                                       <td>@item.SellingPrice.ToString("C")</td>
                                                       <td>
                                                            <p class="mb-1 text-muted"><span class="text-dark fw-medium">@item.Quantity Item</span> Left</p>
                                                            <p class="mb-0 text-muted">@item.OrderItems.Sum(oi => oi.Quantity) Sold</p>
                                                       </td>
                                                       <td>@item.Category?.CategoryName</td>
                                                       <td> 
                                                            <span class="badge p-1 bg-light text-dark fs-12 me-1">
                                                                 <i class="bx bxs-star align-text-top fs-14 text-warning me-1"></i> @item.AverageRating.ToString("F1")
                                                            </span> 
                                                            @item.ReviewCount Review
                                                       </td>
                                                       <td>
                                                            <div class="d-flex gap-2">
                                                                 <button type="button" 
                                                                         onclick="toggleItemStatus('@item.StyleCode', this)" 
                                                                         class="btn btn-light btn-sm status-toggle-btn" 
                                                                         title="Toggle Status">
                                                                      <iconify-icon icon="@(item.IsActive ? "solar:eye-broken" : "solar:eye-closed-broken")" 
                                                                                    class="align-middle fs-18 text-muted"></iconify-icon>
                                                                 </button>
                                                                 <a href="@Url.Action("Edit", "Item", new { area = "Admin", id = item.StyleCode })" class="btn btn-soft-primary btn-sm" title="Edit Product"><iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon></a>
                                                                 <form asp-area="Admin" asp-controller="Item" asp-action="Delete" asp-route-id="@item.StyleCode" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display:inline;">
                                                                      <button type="submit" class="btn btn-soft-danger btn-sm" title="Delete Product"><iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon></button>
                                                                 </form>
                                                            </div>
                                                       </td>
                                                  </tr>
                                             }
                                        }
                                        else
                                        {
                                             <tr>
                                                  <td colspan="7" class="text-center p-4">
                                                       <div class="text-muted">No products found.</div>
                                                  </td>
                                             </tr>
                                        }
                                   </tbody>
                              </table>
                         </div>
                         <!-- end table-responsive -->
                    </div>
                    <div class="card-footer border-top">
                         <nav aria-label="Page navigation example">
                              <ul class="pagination justify-content-end mb-0">
                                   <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = currentPage - 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">Previous</a>
                                   </li>
                                   
                                   @for (int i = 1; i <= totalPages; i++)
                                   {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                             <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = i, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">@i</a>
                                        </li>
                                   }

                                   <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "Item", new { area = "Admin", page = currentPage + 1, searchTerm = ViewBag.SearchTerm, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, isActive = ViewBag.IsActive })">Next</a>
                                   </li>
                              </ul>
                         </nav>
                    </div>
               </div>
          </div>

     </div>
</div>
<!-- End Container Fluid -->

@section Scripts {
    <script>
        function toggleItemStatus(styleCode, btn) {
            const $btn = $(btn);
            const $icon = $btn.find('iconify-icon');
            
            // Disable button during request
            $btn.prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("ToggleStatus", "Item", new { area = "Admin" })',
                type: 'POST',
                data: { 
                    id: styleCode,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        // Update icon and color
                        if (response.isActive) {
                            $icon.attr('icon', 'solar:eye-broken').addClass('text-success').removeClass('text-muted');
                        } else {
                            $icon.attr('icon', 'solar:eye-closed-broken').addClass('text-muted').removeClass('text-success');
                        }
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert('Failed to update product status.');
                },
                complete: function() {
                    $btn.prop('disabled', false);
                }
            });
        }
    </script>
}
