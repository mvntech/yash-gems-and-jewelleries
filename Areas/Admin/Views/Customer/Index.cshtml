@model Yash_Gems___Jewelleries.ViewModels.CustomerIndexViewModel
@{
	ViewData["Title"] = "Customers";
}

<!-- Start Container Fluid -->
<div class="container-xxl">
    <div class="row">
        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="avatar-md bg-primary bg-opacity-10 rounded">
                            <iconify-icon icon="solar:users-group-two-rounded-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                        </div>
                        <div>
                            <h4 class="mb-0">All Customers</h4>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <p class="text-muted fw-medium fs-22 mb-0">@Model.AllCustomersCount</p>
                        <div>
                            <span class="badge text-success bg-success-subtle fs-12"><i class="bx bx-up-arrow-alt"></i>100%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="avatar-md bg-primary bg-opacity-10 rounded">
                            <iconify-icon icon="solar:box-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                        </div>
                        <div>
                            <h4 class="mb-0">Orders</h4>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <p class="text-muted fw-medium fs-22 mb-0">@Model.TotalOrdersCount</p>
                        <div>
                            <span class="badge text-success bg-success-subtle fs-12"><i class="bx bx-up-arrow-alt"></i>Live</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="avatar-md bg-primary bg-opacity-10 rounded">
                            <iconify-icon icon="solar:headphones-round-sound-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                        </div>
                        <div>
                            <h4 class="mb-0">Services Request</h4>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <p class="text-muted fw-medium fs-22 mb-0">@Model.ServiceRequestsCount</p>
                        <div>
                            <span class="badge text-success bg-success-subtle fs-12"><i class="bx bx-up-arrow-alt"></i>Active</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="avatar-md bg-primary bg-opacity-10 rounded">
                            <iconify-icon icon="solar:bill-list-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                        </div>
                        <div>
                            <h4 class="mb-0">Invoice & Payment</h4>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <p class="text-muted fw-medium fs-22 mb-0">@Model.TotalRevenue.ToString("C")</p>
                        <div>
                            <span class="badge text-success bg-success-subtle fs-12"><i class="bx bx-up-arrow-alt"></i>Total</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="d-flex card-header justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title">All Customers List</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <form asp-action="Index" method="get" class="d-flex gap-2">
                            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search..." value="@Model.Search">
                            <select name="isActive" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">All Status</option>
                                <option value="true" selected="@(Model.IsActive == true)">Active</option>
                                <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                            </select>
                        </form>
                    </div>
                </div>
                <div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover table-centered">
                            <thead class="bg-light-subtle">
                                <tr>
                                    <th style="width: 20px;">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="customCheck1">
                                            <label class="form-check-label" for="customCheck1"></label>
                                        </div>
                                    </th>
                                    <th>Customer Name</th>
                                    <th>Latest Invoice</th>
                                    <th>Status</th>
                                    <th>Total Spent</th>
                                    <th>Orders</th>
                                    <th>Last Order</th>
                                    <th>Payment</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Customers != null && Model.Customers.Any())
                                {
                                    @foreach (var item in Model.Customers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" id="customCheck_@item.Customer.Id">
                                                    <label class="form-check-label" for="customCheck_@item.Customer.Id">&nbsp;</label>
                                                </div>
                                            </td>
                                            <td>
                                                <img src="/admin/images/users/avatar-@(new Random().Next(1, 11)).jpg" class="avatar-sm rounded-circle me-2" alt="..."> 
                                                <a href="@Url.Action("Detail", "Customer", new { id = item.Customer.Id })" class="text-body fw-medium">
                                                    @item.Customer.FirstName @item.Customer.LastName
                                                </a>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.LatestInvoiceId))
                                                {
                                                    <a href="javascript: void(0);" class="text-body">#@item.LatestInvoiceId</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No Invoices</span>
                                                }
                                            </td>
                                            <td> 
                                                @if (item.Customer.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success py-1 px-2">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger py-1 px-2">Inactive</span>
                                                }
                                            </td>
                                            <td> @item.TotalSpent.ToString("C") </td>
                                            <td> @item.OrderCount </td>
                                            <td> @(item.LatestOrderDate?.ToString("dd MMM, yyyy") ?? "N/A")</td>
                                            <td> @(item.PreferredPaymentMethod ?? "N/A") </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <a href="@Url.Action("Detail", "Customer", new { id = item.Customer.Id })" class="btn btn-light btn-sm" title="View Detail"><iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon></a>
                                                    <form asp-action="ToggleActive" asp-route-id="@item.Customer.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <a href="#!" class="btn btn-soft-danger btn-sm"><iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon></a>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4">
                                            <p class="text-muted mb-0">No customers found matching your criteria.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end table-responsive -->
                </div>
                <div class="card-footer border-top">
                    <nav aria-label="Page navigation example">
                        <ul class="pagination justify-content-end mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.Search, isActive = Model.IsActive })">Previous</a>
                            </li>
                            
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.Search, isActive = Model.IsActive })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.Search, isActive = Model.IsActive })">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- End Container Fluid -->


