@model Yash_Gems___Jewelleries.ViewModels.CustomerIndexViewModel
@{
	ViewData["Title"] = "Customers";
}

<!-- Start Container Fluid -->
<div class="container-xxl">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="d-flex card-header justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title">All Customers List</h4>
                    </div>
                    <div class="d-flex gap-2">
                        <form asp-action="Index" method="get" class="d-flex gap-2">
                            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search..." value="@Model.Search">
                            <div class="dropdown">
                              <a href="#" class="dropdown-toggle btn btn-sm btn-outline-light" data-bs-toggle="dropdown" aria-expanded="false">
                                   @(ViewBag.IsActive == true ? "Active" : ViewBag.IsActive == false ? "Inactive" : "Status")
                              </a>
                              <div class="dropdown-menu dropdown-menu-end">
                                  <a class="dropdown-item" href="@Url.Action("Index", "Customer", new { area = "Admin", searchTerm = ViewBag.SearchTerm })">All Status</a>
                                   <a class="dropdown-item" href="@Url.Action("Index", "Customer", new { area = "Admin", isActive = true, searchTerm = ViewBag.SearchTerm })">Active</a>
                                   <a class="dropdown-item" href="@Url.Action("Index", "Customer", new { area = "Admin", isActive = false, searchTerm = ViewBag.SearchTerm })">Inactive</a>
                              </div>
                         </div>
                        </form>
                    </div>
                </div>
                <div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover table-centered">
                            <thead class="bg-light-subtle">
                                <tr>
                                    <th>Customer Info</th>
                                    <th>Latest Invoice</th>
                                    <th>Status</th>
                                    <th>Total Spent</th>
                                    <th>Orders</th>
                                    <th>Last Order</th>
                                    <th>Payment</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Customers != null && Model.Customers.Any())
                                {
                                    @foreach (var item in Model.Customers)
                                    {
                                        <tr>
                                            <td>
                                               <div class="d-flex align-items-center gap-2">
                                                                 <div class="rounded bg-light avatar-md d-flex align-items-center justify-content-center">
                                                                      <img src="@(string.IsNullOrEmpty(item.Customer.ProfilePictureUrl) ? "/uploads/dummy-user.jpg" : item.Customer.ProfilePictureUrl)" alt="Platinum Diamond Pendant" class="avatar-md">
                                                                 </div>
                                                                 <div>
                                                                      <a href="@Url.Action("Detail", "Customer", new { id = item.Customer.Id })" class="text-dark fw-medium fs-15">@item.Customer.FirstName @item.Customer.LastName</a>
                                                                      <p class="text-muted mb-0 mt-1 fs-13">@item.Customer.Email</p>
                                                                 </div>
                                                            </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.LatestInvoiceId))
                                                {
                                                    <a href="javascript: void(0);" class="text-body">#@item.LatestInvoiceId</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No Invoices</span>
                                                }
                                            </td>
                                            <td> 
                                                @if (item.Customer.IsActive)
                                                {
                                                    <span class="badge border border-success text-success px-2 py-1 fs-13">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge border border-danger text-danger px-2 py-1 fs-13">Inactive</span>
                                                }
                                            </td>
                                            <td> @item.TotalSpent.ToString("C") </td>
                                            <td> @item.OrderCount </td>
                                            <td> @(item.LatestOrderDate?.ToString("dd MMM, yyyy") ?? "N/A")</td>
                                            <td> @(item.PreferredPaymentMethod ?? "N/A") </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <a href="@Url.Action("Detail", "Customer", new { id = item.Customer.Id })" class="btn btn-light btn-sm" title="View Detail"><iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon></a>
                                                    <button type="button" 
                                                            onclick="toggleCustomerStatus('@item.Customer.Id', this, '@item.Customer.FirstName @item.Customer.LastName', @item.Customer.IsActive.ToString().ToLower())" 
                                                            class="btn @(item.Customer.IsActive ? "btn-soft-danger" : "btn-soft-success") btn-sm"
                                                            title="@(item.Customer.IsActive ? "Deactivate" : "Activate")">
                                                        <iconify-icon icon="@(item.Customer.IsActive ? "solar:lock-keyhole-broken" : "solar:lock-keyhole-minimalistic-broken")" class="align-middle fs-18"></iconify-icon>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4">
                                            <p class="text-muted mb-0">No customers found matching your criteria.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end table-responsive -->
                </div>
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer border-top">
                        <nav aria-label="Page navigation example">
                            <ul class="pagination justify-content-end mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.Search, isActive = Model.IsActive })">Previous</a>
                                </li>

                                @{
                                    int maxPagesToShow = 5;
                                    int startPage = Math.Max(1, Model.CurrentPage - (maxPagesToShow / 2));
                                    int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

                                    if (endPage - startPage + 1 < maxPagesToShow)
                                    {
                                        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = 1, search = Model.Search, isActive = Model.IsActive })">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.Search, isActive = Model.IsActive })">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, search = Model.Search, isActive = Model.IsActive })">@Model.TotalPages</a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.Search, isActive = Model.IsActive })">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
<!-- End Container Fluid -->

@section Scripts {
    <script>
        function toggleCustomerStatus(id, btn, name, isActive) {
            const $btn = $(btn);
            const $icon = $btn.find('iconify-icon');
            const $row = $btn.closest('tr');
            const $badge = $row.find('.badge');
            const action = isActive ? "Deactivate" : "Activate";
            
            AdminPanel.confirmAction({
                title: action + ' Customer?',
                text: `Are you sure you want to ${action.toLowerCase()} ${name}?`,
                confirmButtonText: 'Yes, ' + action + '!',
                confirmButtonColor: isActive ? '#d33' : '#28a745'
            }, function() {
                $btn.prop('disabled', true);
                $.ajax({
                    url: '@Url.Action("ToggleActive", "Customer", new { area = "Admin" })',
                    type: 'POST',
                    data: { 
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        AdminPanel.handleResponse(response, function() {
                            if (response.success) {
                                // Update local state for next toggle
                                const newState = !isActive;
                                
                                // Update Badge
                                if (newState) {
                                    $badge.removeClass('border-danger text-danger').addClass('border-success text-success').text('Active');
                                } else {
                                    $badge.removeClass('border-success text-success').addClass('border-danger text-danger').text('Inactive');
                                }

                                // Update Button
                                $btn.removeClass('btn-soft-success btn-soft-danger').addClass(newState ? 'btn-soft-danger' : 'btn-soft-success');
                                $btn.attr('title', newState ? 'Deactivate' : 'Activate');
                                $icon.attr('icon', newState ? 'solar:lock-keyhole-broken' : 'solar:lock-keyhole-minimalistic-broken');
                                
                                // Update the onclick function for the next time
                                $btn.attr('onclick', `toggleCustomerStatus('${id}', this, '${name}', ${newState})`);
                            }
                        });
                    },
                    error: function (xhr) {
                        AdminPanel.showToast('Error: ' + (xhr.responseJSON?.message || 'Failed to update status'), 'danger');
                    },
                    complete: function() {
                        $btn.prop('disabled', false);
                    }
                });
            });
        }
    </script>
}


