@model Yash_Gems___Jewelleries.ViewModels.CustomerDetailViewModel
@using Yash_Gems___Jewelleries.Models.Enums
@{
	ViewData["Title"] = Model.Customer.FirstName + " " + Model.Customer.LastName + "'s Profile";
}

<!-- Start Container Fluid -->
<div class="container-xxl">
    <div class="row">
        <div class="col-lg-4">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="bg-primary profile-bg rounded-top p-5 position-relative mx-n3 mt-n3">
                        <img src="@(Model.Customer.ProfilePictureUrl ?? "/uploads/dummy-user.jpg")" alt="" class="avatar-lg border border-light border-3 rounded-circle position-absolute top-100 start-0 translate-middle ms-5">
                    </div>
                    <div class="mt-4 pt-3">
                        <h4 class="mb-1"> @Model.Customer.FirstName @Model.Customer.LastName <i class="bx bxs-badge-check text-success align-middle"></i></h4>
                        <div class="mt-2">
                            <p class="fs-15 mb-1 mt-1"><span class="text-dark fw-semibold">Email : </span> @Model.Customer.Email</p>
                            <p class="fs-15 mb-0 mt-1"><span class="text-dark fw-semibold">Phone : </span> @(Model.Customer.PhoneNumber ?? "N/A")</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer border-top gap-1 hstack">
                    <a href="mailto:@Model.Customer.Email" class="btn btn-primary w-100">Send Email</a>
                    <button type="button" 
                            onclick="toggleCustomerStatus('@Model.Customer.Id', this, '@Model.Customer.FirstName @Model.Customer.LastName', @Model.Customer.IsActive.ToString().ToLower())" 
                            class="btn @(Model.Customer.IsActive ? "btn-soft-dark" : "btn-soft-success") w-100">
                        @(Model.Customer.IsActive ? "Deactivate" : "Activate")
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title">Customer Details</h4>
                    </div>
                    <div>
                        @if (Model.Customer.IsActive)
                        {
                            <span class="badge border border-success text-success px-2 py-1 fs-13">Active User</span>
                        }
                        else
                        {
                            <span class="badge border border-danger text-danger px-2 py-1 fs-13">Inactive</span>
                        }
                    </div>

                </div>
                <div class="card-body py-2">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                <tr>
                                    <td class="px-0">
                                        <p class="d-flex mb-0 align-items-center gap-1 fw-semibold text-dark">Customer ID : </p>
                                    </td>
                                    <td class="text-dark fw-medium px-0">#@Model.Customer.Id.Substring(0, 8).ToUpper()</td>
                                </tr>
                                <tr>
                                    <td class="px-0">
                                        <p class="d-flex mb-0 align-items-center gap-1 fw-semibold text-dark"> Profile Email : </p>
                                    </td>
                                    <td class="text-dark fw-medium px-0">@Model.Customer.Email</td>
                                </tr>
                                <tr>
                                    <td class="px-0">
                                        <p class="d-flex mb-0 align-items-center gap-1 fw-semibold text-dark"> Default Address : </p>
                                    </td>
                                    <td class="text-dark fw-medium px-0">
                                        @(Model.Customer.Address ?? "N/A")
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-0">
                                        <p class="d-flex mb-0 align-items-center gap-1 fw-semibold text-dark"> Joined Date : </p>
                                    </td>
                                    <td class="text-dark fw-medium px-0">@Model.Customer.CreatedDate.ToString("dd MMM, yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="px-0">
                                        <p class="d-flex mb-0 align-items-center gap-1 fw-semibold text-dark"> Newsletter : </p>
                                    </td>
                                    <td class="px-0">
                                        @if (Model.IsNewsletterSubscribed)
                                        {
                                            <span class="text-dark fw-medium">Subscribed</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-medium">Unsubscribed</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-0">
                                        <p class="d-flex mb-0 align-items-center gap-1 fw-semibold text-dark"> Latest Order ID : </p>
                                    </td>
                                    <td class="text-dark fw-medium px-0">@(Model.LatestOrder != null ? "#" + Model.LatestOrder.OrderNumber : "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header border-bottom border-dashed">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-block">
                            <h4 class="card-title mb-1">Latest Invoices</h4>
                            <p class="mb-0 text-muted">Recent order billing documents</p>
                        </div>
                        <div class="ms-auto">
                            <a href="#!" class="btn btn-primary btn-sm">View All</a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        @foreach (var order in Model.Orders.Take(4))
                        {
                            <div class="d-flex p-2 rounded align-items-center gap-2 bg-light-subtle @(order != Model.Orders.First() ? "mt-2" : "")">
                                <div class="avatar bg-primary-subtle d-flex align-items-center justify-content-center rounded-circle">
                                    <iconify-icon icon="solar:file-download-bold" class="text-primary fs-3"></iconify-icon>
                                </div>
                                <div class="d-block">
                                    <a href="#!" class="text-dark fw-medium">Invoice #@order.OrderNumber</a>
                                    <p class="text-muted mb-0 fs-13">@order.OrderDate.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-muted py-3">No invoices found.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="row">
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Invoices</h4>
                                    <p class="text-muted fw-medium fs-22 mb-0">@Model.TotalInvoices</p>
                                </div>
                                <div>
                                    <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                        <iconify-icon icon="solar:bill-list-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Orders</h4>
                                    <p class="text-muted fw-medium fs-22 mb-0">@Model.TotalOrders</p>
                                </div>
                                <div>
                                    <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                        <iconify-icon icon="solar:box-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h4 class="card-title mb-2 d-flex align-items-center gap-2">Total Spent</h4>
                                    <p class="text-muted fw-medium fs-22 mb-0">@Model.TotalSpent.ToString("C")</p>
                                </div>
                                <div>
                                    <div class="avatar-md bg-primary bg-opacity-10 rounded">
                                        <iconify-icon icon="solar:chat-round-money-bold-duotone" class="fs-32 text-primary avatar-title"></iconify-icon>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Order History</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover table-centered">
                            <thead class="bg-light-subtle">
                                <tr>
                                    <th>Order Number</th>
                                    <th>Status</th>
                                    <th>Total Amount</th>
                                    <th>Order Date</th>
                                    <th>Payment Method</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Orders != null && Model.Orders.Any())
                                {
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td><a href="javascript: void(0);" class="text-body fw-medium">#@order.OrderNumber</a> </td>
                                            <td> 
                                                <span class="badge @(order.OrderStatus == OrderStatus.Delivered ? "bg-success-subtle text-success" : (order.OrderStatus == OrderStatus.Cancelled ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary")) py-1 px-2">@order.OrderStatus</span> 
                                            </td>
                                            <td> @order.TotalAmount.ToString("C") </td>
                                            <td> @order.OrderDate.ToString("dd MMM, yyyy")</td>
                                            <td> @order.PaymentMethod </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4">
                                            <p class="text-muted mb-0">No transaction history found for this customer.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if(Model.Orders != null && Model.Orders.Any())
                {
                    <div class="card-footer border-top text-end">
                        <a href="#!" class="btn btn-sm btn-light">View All Transactions</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- End Container Fluid -->