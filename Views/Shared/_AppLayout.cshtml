    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Function to handle form submission via AJAX
            async function handleAuthFormSubmission(formId, endpoint, errorId, successId) {
                const form = document.getElementById(formId);
                const errorDiv = document.getElementById(errorId);
                const successDiv = successId ? document.getElementById(successId) : null;

                if (!form) return;

                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    if (errorDiv) errorDiv.style.display = 'none';
                    if (successDiv) successDiv.style.display = 'none';

                    const formData = new FormData(form);
                    
                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            }
                        });
                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                if (successDiv) {
                                    successDiv.textContent = 'Action successful! Please check your email if required.';
                                    successDiv.style.display = 'block';
                                    form.reset();
                                }
                                if (result.redirectUrl) {
                                    window.location.href = result.redirectUrl;
                                } else {
                                    window.location.reload();
                                }
                            } else {
                                if (errorDiv) {
                                    if (result.errors && Array.isArray(result.errors)) {
                                        errorDiv.innerHTML = '<ul>' + result.errors.map(e => `<li>${e}</li>`).join('') + '</ul>';
                                    } else {
                                        errorDiv.textContent = result.message || 'An error occurred. Please try again.';
                                    }
                                    errorDiv.style.display = 'block';
                                }
                            }
                        } else {
                            // Fallback for non-JSON responses
                            if (errorDiv) {
                                errorDiv.textContent = 'An unexpected server error occurred. Please try again later.';
                                errorDiv.style.display = 'block';
                            }
                        }
                    } catch (err) {
                        console.error('Auth request failed:', err);
                        if (errorDiv) {
                            errorDiv.textContent = 'Connection error. Please try again later.';
                            errorDiv.style.display = 'block';
                        }
                    }
                });
            }

            // Wire up the forms
            handleAuthFormSubmission('loginForm', '/Account/Login', 'login-error');
            handleAuthFormSubmission('registerForm', '/Account/Register', 'register-error', 'register-success');
            handleAuthFormSubmission('resetForm', '/Account/ForgotPassword', 'reset-error', 'reset-success');

            // Handle modal auto-trigger from URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const modalTrigger = urlParams.get('modal');
            if (modalTrigger === 'login') {
                const loginModal = new bootstrap.Modal(document.getElementById('log'));
                loginModal.show();
            } else if (modalTrigger === 'register') {
                const registerModal = new bootstrap.Modal(document.getElementById('register'));
                registerModal.show();
            }
            // --- Quick View Logic ---
            $(document).on('click', '.quickview', function() {
                const styleCode = $(this).data('stylecode');
                if (!styleCode) return;
                const $modal = $('#quickView');
                
                // Clear previous data or show loading state
                $modal.find('.product-info-name').text('Loading...');
                $modal.find('.price-new').text('');
                $modal.find('.price-old').text('').hide();
                $modal.find('.badges-on-sale').hide();
                $modal.find('.product-infor-sub').text('');
                $.ajax({
                    url: '/Shop/GetQuickDetails/' + styleCode,
                    type: 'GET',
                    success: function(data) {
                        // Populate Basic Info
                        $modal.find('.product-info-name').text(data.itemName).attr('href', '/Shop/ProductDetail/' + data.styleCode);
                        $modal.find('.price-new').text(data.sellingPriceFormatted);
                        $modal.find('.price-add').text(data.sellingPriceFormatted);
                        
                        if (data.isOnSale) {
                            $modal.find('.price-old').text(data.mrpFormatted).show();
                            $modal.find('.number-sale').text(Math.round(data.discountPercentage) + '% OFF');
                            $modal.find('.badges-on-sale').show();
                        } else {
                            $modal.find('.price-old').hide();
                            $modal.find('.badges-on-sale').hide();
                        }
                        $modal.find('.product-infor-sub').text(data.description || 'No description available.');
                        $modal.find('.value-currentColor').text(data.goldKarat || 'N/A');
                        $modal.find('.value-currentSize').text(data.productType || 'N/A');
                        
                        // Hide generic color/size pickers since we don't have multiple variants per style code yet
                        $modal.find('.variant-color .variant-picker-values').hide();
                        $modal.find('.variant-size .variant-picker-values .btn-group').hide();
                        $modal.find('.variant-size .variant-picker-values .tf-btn-line').hide();
                        // Update Modal Buttons
                        const $atbBtn = $modal.find('.btn-add-to-cart');
                        $atbBtn.attr('data-stylecode', data.styleCode);
                        
                        if (data.quantity <= 0) {
                            $atbBtn.addClass('disabled').text('OUT OF STOCK').find('i, .price-add').hide();
                        } else {
                            $atbBtn.removeClass('disabled').html('<span class="text-line-clamp-1">add to bag</span><i class="icon-minus d-none d-sm-block"></i><span class="price-add d-none d-sm-block">' + data.sellingPriceFormatted + '</span>');
                        }
                        $modal.find('.view-full-details').attr('href', '/Shop/ProductDetail/' + data.styleCode);
                        $modal.find('.btn-buy-now').data('stylecode', data.styleCode);

                        // Update Wishlist Button
                        var $wishlistBtn = $modal.find('.btn-add-wishlist');
                        $wishlistBtn.attr('data-stylecode', data.styleCode);
                        if (data.isWishlisted) {
                            $wishlistBtn.addClass('active').attr('title', 'Remove from Wishlist');
                            $wishlistBtn.find('.icon').removeClass('icon-heart-2').addClass('icon-trash');
                            $wishlistBtn.find('.tooltip').text('Remove from Wishlist');
                        } else {
                            $wishlistBtn.removeClass('active').attr('title', 'Add to Wishlist');
                            $wishlistBtn.find('.icon').removeClass('icon-trash').addClass('icon-heart-2');
                            $wishlistBtn.find('.tooltip').text('Add to Wishlist');
                        }

                        // Update Images / Swiper
                        const $wrapper = $modal.find('.swiper-wrapper');
                        $wrapper.empty();
                        if (data.images && data.images.length > 0) {
                            data.images.forEach(img => {
                                $wrapper.append(`
                                    <div class="swiper-slide">
                                        <div class="item">
                                            <img src="${img}" alt="${data.itemName}">
                                        </div>
                                    </div>
                                `);
                            });
                        } else {
                            $wrapper.append(`
                                <div class="swiper-slide">
                                    <div class="item">
                                        <img src="/app/images/products/product-default.jpg" alt="${data.itemName}">
                                    </div>
                                </div>
                            `);
                        }
                        // Re-initialize or update Swiper
                        if ($modal.find('.tf-single-slide')[0].swiper) {
                            $modal.find('.tf-single-slide')[0].swiper.destroy();
                        }
                        new Swiper($modal.find('.tf-single-slide')[0], {
                            loop: false,
                            autoplay: false,
                            spaceBetween: 0,
                            speed: 1000,
                            navigation: {
                                nextEl: ".single-slide-next",
                                prevEl: ".single-slide-prev",
                            },
                        });
                    },
                    error: function() {
                        alert('Error loading product details.');
                        $modal.modal('hide');
                    }
                });
            });
            $(document).on('click', '.btn-buy-now', function() {
                const styleCode = $(this).data('stylecode');
                const quantity = $('#quickView .quantity-product').val() || 1;
                if (!styleCode) return;
                // Add to cart and then redirect to checkout
                $.ajax({
                    url: '/Cart/AddToCart',
                    type: 'POST',
                    data: { styleCode: styleCode, quantity: quantity },
                    success: function (response) {
                        if (response.success) {
                            window.location.href = '/Checkout';
                        } else {
                            alert(response.message);
                        }
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
