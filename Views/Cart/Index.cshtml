@model Yash_Gems___Jewelleries.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "My Cart";
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-controller="Home" asp-action="Index" class="text-main-4 link">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>Cart</li>
                </ul>
                <h1 class="heading fw-normal">
                    shopping cart
                </h1>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->

<!-- Shop Cart -->
<section class="flat-spacing s-shop-cart each-list-prd">
    <div class="container" id="cart-main-container">
        <div class="row">
        @if (Model.Items.Any())
        {
            <div class="col-xl-8">
                <div class="left mb-xl-0">
                    <div class="table-shop-cart table-order-detail">
                        <table>
                            <thead>
                                <tr>
                                    <th class="order_product h6 fw-normal">Product</th>
                                    <th class="order_price h6 fw-normal">price</th>
                                    <th class="order_quantity h6 fw-normal">quantity</th>
                                    <th class="order_subtotal h6 fw-normal">subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items-container">
                                <partial name="~/Views/Cart/_CartItemsPartial.cshtml" model="Model" />
                            </tbody>
                        </table>
                    </div>
                    
                    <form class="style-border">
                        <fieldset>
                            <label class="label-text">Special instructions for seller</label>
                            <textarea style="height: 206px;"></textarea>
                        </fieldset>
                    </form>
                </div>
            </div>
            <div class="col-xl-4" id="cart-summary-container">
                <partial name="~/Views/Cart/_CartSummaryPartial.cshtml" model="Model" />
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <div class="my-acount-content account-order empty">
                        <div class="ic-img">
                            <img src="/app/images/section/empty-cart.svg" alt="Empty Cart">
                        </div>
                        <p class="title text-lg-2">Your cart is empty</p>
                        <p class="sub-title">It's time to fill it with your favorites!</p>
                        <a asp-action="Index" asp-controller="Shop" class="tf-btn fw-medium btn-out-line">
                            SHOPPING
                        </a>
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
</section>
<!-- /Shop Cart -->
<!-- For You -->
<section class="flat-spacing pt-0">
