@model Yash_Gems___Jewelleries.Models.Item
@{
	ViewData["Title"] = Model.ItemName;
}

<!-- Page Title -->
<div class="flat-spacing-16 pb-0">
    <div class="container">
        <div class="page-title border-0">
            <div class="breadcrumbs">
                <ul class="bread-wrap mb-0">
                    <li><a asp-controller="Home" asp-action="Index" class="text-main-4 link">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li><a asp-controller="Shop" asp-action="Index" class="text-main-4 link">Shop</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>
                        <p>@Model.ItemName</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /Page Title -->
<!-- Product Detail -->
<section class="flat-spacing pt-0">
    <div class="tf-main-product section-image-zoom">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="tf-product-media-wrap sticky-top">
                        <div class="thumbs-slider">
                            <div class="flat-wrap-media-product">
                                <div dir="ltr" class="swiper tf-product-media-main" id="gallery-swiper-started">
                                    <div class="swiper-wrapper">
                                        @{
                                            var images = new[] { Model.PrimaryImageUrl, Model.SecondaryImageUrl, Model.TertiaryImageUrl }
                                            .Where(img => !string.IsNullOrEmpty(img))
                                            .ToList();
                                        }
                                        @for (int i = 0; i < images.Count; i++)
                                        {
                                            <div class="swiper-slide" data-color="gold" data-size="48">
                                                <a href="@images[i]" target="_blank" class="item"
                                                   data-pswp-width="593px" data-pswp-height="744px">
                                                    <img class="tf-image-zoom lazyload"
                                                         data-zoom="@images[i]"
                                                         data-src="@images[i]"
                                                         src="@images[i]" alt="@Model.ItemName - Image @(i + 1)">
                                                </a>
                                            </div>
                                        }
                                    </div>
                                    <div class="sw-nav-box sw-nav-prev thumbs-prev"><i class="icon-arrow-left"></i></div>
                                    <div class="sw-nav-box sw-nav-next thumbs-next"><i class="icon-arrow-right"></i></div>
                                    <div class="swiper-pagination thumbs-pagination"></div>
                                </div>
                            </div>
                            @if (images.Count > 1)
                            {
                                <div dir="ltr" class="swiper tf-product-media-thumbs" data-preview="4" data-direction="horizontal">
                                    <div class="swiper-wrapper stagger-wrap">
                                        @for (int i = 0; i < images.Count; i++)
                                        {
                                            <div class="swiper-slide stagger-item" data-color="gold">
                                                <div class="item">
                                                    <img data-src="@images[i]"
                                                         src="@images[i]" alt="@Model.ItemName - Image @(i + 1)" class="lazyload">
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="tf-product-info-wrap">
                        <div class="tf-zoom-main sticky-top"></div>
                        <div class="tf-product-info-list other-image-zoom">
                            <div class="tf-product-info-heading">
                                <ul class="product-info-rate rate-wrap">
                                    <li><i class="icon-star"></i></li>
                                    <li><i class="icon-star"></i></li>
                                    <li><i class="icon-star"></i></li>
                                    <li><i class="icon-star"></i></li>
                                    <li><i class="icon-star"></i></li>
                                </ul>
                                <h3 class="product-info-name fw-normal">
                                    @Model.ItemName
                                </h3>
                                <div class="product-info-price">
                                     <div class="price-wrap">
                                         <span class="price-new price-on-sale h4">@Model.SellingPrice.ToString("C")</span>
                                         @if (Model.MRP > Model.SellingPrice)
                                         {
                                             <span class="price-old compare-at-price fw-normal h6">@Model.MRP.ToString("C")</span>
                                             <p class="badges-on-sale">
                                                 <i class="icon-tag"></i>
                                                 <span class="number-sale">
                                                     @(((Model.MRP - Model.SellingPrice) / Model.MRP * 100).ToString("0"))% OFF
                                                 </span>
                                             </p>
                                         }
                                     </div>
                                 </div>
                                 <p class="product-infor-sub h6 fw-normal text-main-4">
                                     @Model.Description
                                 </p>
                                 @if (Model.Quantity > 0 && Model.Quantity <= 10)
                                 {
                                     <div class="product-info-progress-sale">
                                         <h6 class="text-hurry-up fw-normal">Only @Model.Quantity items left</h6>
                                         <div class="progress-cart">
                                             <div class="value" style="width: @(100 - (Model.Quantity * 10))%;" data-progress="@(100 - (Model.Quantity * 10))"></div>
                                         </div>
                                     </div>
                                 }
                                 else if (Model.Quantity <= 0)
                                 {
                                     <div class="product-info-progress-sale">
                                         <h6 class="text-hurry-up fw-normal text-danger">Out of Stock</h6>
                                     </div>
                                 }
                            </div>
                            <div class="tf-product-info-variant d-none">
                                @* Variants hidden as each StyleCode is a unique product *@
                            </div>
                            <div class="tf-product-info-variant">
                                <div class="variant-picker-item">
                                    <div class="variant-picker-label h6 fw-normal">Quantity</div>
                                    <div class="variant-picker-values">
                                        <div class="wg-quantity">
                                            <button class="btn-quantity btn-decrease"><i class="icon-minus"></i></button>
                                            <input class="quantity-product" type="text" name="number" value="1" @(Model.Quantity <= 0 ? "disabled" : "")>
                                            <button class="btn-quantity btn-increase"><i class="icon-plus"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tf-product-total-quantity">
                                <div class="group-btn">
                                    <a href="#shoppingCart" data-bs-toggle="offcanvas"
                                       class="tf-btn btn-fill-2 text-uppercase fw-medium animate-btn btn-add-to-cart @(Model.Quantity <= 0 ? "disabled" : "")"
                                       data-stylecode="@Model.StyleCode">
                                        @if (Model.Quantity <= 0)
                                        {
                                            <span>out of stock</span>
                                        }
                                        else
                                        {
                                            <span>add to bag</span>
                                            <i class="icon-minus d-none d-sm-block"></i>
                                            <span class="price-add d-none d-sm-block">@Model.SellingPrice.ToString("C")</span>
                                        }
                                    </a>
                                    <div class="group-btn-action">
                                        <a href="javascript:void(0);" class="tf-btn-icon hover-tooltip btn-add-wishlist">
                                            <span class="icon icon-heart-2"></span>
                                            <span class="tooltip">Add to Wishlist</span>
                                        </a>
                                        @* <a href="#compare" data-bs-toggle="modal" aria-controls="compare" class="tf-btn-icon hover-tooltip">
                                            <span class="icon icon-compare"></span>
                                            <span class="tooltip">Compare</span>
                                        </a> *@
                                    </div>
                                </div>
                                @if (Model.Quantity > 0)
                                {
                                    <a href="javascript:void(0);" class="tf-btn w-100 text-uppercase fw-medium btn-buy-now" data-stylecode="@Model.StyleCode">
                                        buy it now
                                    </a>
                                }
                            </div>
                            <div class="tf-product-share">
                                <ul class="tf-social-icon">
                                    <li>
                                        <a href="#" class="social-facebook">
                                            <span class="icon"><i class="icon-facebook"></i></span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#" class="social-instagram">
                                            <span class="icon"><i class="icon-instagram"></i></span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#" class="social-x">
                                            <span class="icon"><i class="icon-x"></i></span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#" class="social-snapchat">
                                            <span class="icon"><i class="icon-snapchat"></i></span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
