<!-- For You -->
<section class="flat-spacing-3">
    <div class="container">
        <div class="sect-top wow fadeInUp">
            <h3 class="s-title">YOU MAY ALSO LIKE</h3>
            <div class="group-btn-slider">
                <div class="nav-prev-swiper tf-sw-nav">
                    <i class="icon-arrow-left"></i>
                </div>
                <div class="nav-next-swiper tf-sw-nav">
                    <i class="icon-arrow-right"></i>
                </div>
            </div>
        </div>
        <div dir="ltr" class="swiper tf-swiper wow fadeInUp" data-preview="4" data-tablet="3" data-mobile-sm="2" data-mobile="2"
             data-space-lg="30" data-space-md="20" data-space="15" data-pagination="2" data-pagination-sm="2" data-pagination-md="3"
             data-pagination-lg="4">
            <div class="swiper-wrapper">
                @if (ViewBag.RelatedProducts != null)
                {
                    foreach (var related in (IEnumerable<Yash_Gems___Jewelleries.Models.Item>)ViewBag.RelatedProducts)
                    {
                        <div class="swiper-slide">
                            <div class="card_product--V01">
                                <div class="card_product-wrapper">
                                    <a asp-action="ProductDetail" asp-route-id="@related.StyleCode" class="product-img">
                                        <img src="@related.PrimaryImageUrl" data-src="@related.PrimaryImageUrl" alt="@related.ItemName"
                                             class="lazyload img-product">
                                        <img src="@(string.IsNullOrEmpty(related.SecondaryImageUrl) ? related.PrimaryImageUrl : related.SecondaryImageUrl)" 
                                             data-src="@(string.IsNullOrEmpty(related.SecondaryImageUrl) ? related.PrimaryImageUrl : related.SecondaryImageUrl)" 
                                             alt="@related.ItemName"
                                             class="lazyload img-hover">
                                    </a>
                                    <ul class="list-product-btn">
                                        <li class="wishlist">
                                            <a href="javascript:void(0);" class="hover-tooltip tooltip-left box-icon">
                                                <span class="icon icon-heart-2"></span>
                                                <span class="tooltip">Add to Wishlist</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#shoppingCart" data-bs-toggle="offcanvas" class="hover-tooltip tooltip-left box-icon btn-add-to-cart" data-stylecode="@related.StyleCode">
                                                <span class="icon icon-shop-cart"></span>
                                                <span class="tooltip">Add to Cart</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon quickview" data-stylecode="@related.StyleCode">
                                                <span class="icon icon-view"></span>
                                                <span class="tooltip">Quick View</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="card_product-info">
                                    <a asp-action="ProductDetail" asp-route-id="@related.StyleCode" class="name-product h5 fw-normal link text-line-clamp-2">
                                        @related.ItemName
                                    </a>
                                    <div class="price-wrap">
                                        <span class="price-new h5">@related.SellingPrice.ToString("C")</span>
                                        @if (related.MRP > related.SellingPrice)
                                        {
                                            <span class="price-old fw-normal">@related.MRP.ToString("C")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="sw-dot-default tf-sw-pagination d-xl-none"></div>
        </div>
    </div>
</section>
<!-- /For You -->
