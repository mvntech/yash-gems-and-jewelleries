@model IEnumerable<Yash_Gems___Jewelleries.Models.Item>
@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as IEnumerable<Yash_Gems___Jewelleries.Models.Masters.Category> ?? Array.Empty<Yash_Gems___Jewelleries.Models.Masters.Category>();
    var brands = ViewBag.Brands as IEnumerable<Yash_Gems___Jewelleries.Models.Masters.Brand> ?? Array.Empty<Yash_Gems___Jewelleries.Models.Masters.Brand>();
    var productTypes = ViewBag.ProductTypes as IEnumerable<Yash_Gems___Jewelleries.Models.Masters.ProductType> ?? Array.Empty<Yash_Gems___Jewelleries.Models.Masters.ProductType>();
    var goldKarats = ViewBag.GoldKarats as IEnumerable<Yash_Gems___Jewelleries.Models.Masters.GoldKarat> ?? Array.Empty<Yash_Gems___Jewelleries.Models.Masters.GoldKarat>();

    var selectedCategoryIds = ViewBag.SelectedCategories as int[] ?? Array.Empty<int>();
    var selectedBrandIds = ViewBag.SelectedBrands as int[] ?? Array.Empty<int>();
    var selectedProductTypeIds = ViewBag.SelectedProductTypes as int[] ?? Array.Empty<int>();
    var selectedGoldTypeIds = ViewBag.SelectedGoldTypes as int[] ?? Array.Empty<int>();

    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    var sortBy = (string?)ViewBag.SortBy;

    string breadcrumbText = "Shop";
    if (selectedCategoryIds.Length == 1)
    {
        var cat = categories.FirstOrDefault(c => c.CategoryId == selectedCategoryIds[0]);
        if (cat != null) breadcrumbText = cat.CategoryName;
    }
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title type-2">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-controller="Home" asp-action="Index" class="text-main-4 link-secondary">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>
                        <p>@breadcrumbText</p>
                    </li>
                </ul>
                <h1 class="heading fw-normal text-uppercase">
                    @breadcrumbText
                    <span class="number-count">
                        @totalItems
                    </span>
                </h1>
            </div>
            <div class="box-text">
                <p class="text-main-4">
                    Discover our exquisite collection of jewellery. From elegant rings and bracelets to stunning necklaces, 
                    crafted with the finest materials to celebrate your special moments. 
                    Explore our curated selection of @breadcrumbText to find your perfect match.
                </p>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->
<!-- Category -->
<div class="flat-spacing-5">
    <div class="container-6">
        <div class="swiper tf-swiper" data-preview="5" data-tablet="4" data-mobile-sm="3" data-mobile="2" data-space-lg="30"
             data-space-md="20" data-space="15" data-pagination="2" data-pagination-sm="3" data-pagination-md="4" data-pagination-lg="5">
            <div class="swiper-wrapper">
                @foreach (var cat in categories.Where(c => c.IsActive))
                {
                    <div class="swiper-slide">
                        <div class="box_collection--V01 style_2 hover-img">
                            <a asp-action="Index" asp-route-categoryIds="@cat.CategoryId" class="image img-style">
                                <img src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "/app/images/collections/cls-13.jpg" : cat.ImageUrl)" 
                                     data-src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "/app/images/collections/cls-13.jpg" : cat.ImageUrl)" 
                                     alt="@cat.CategoryName" class="lazyload">
                            </a>
                            <a asp-action="Index" asp-route-categoryIds="@cat.CategoryId" class="name-cls link">
                                <span class="h5 fw-normal text-uppercase">
                                    @cat.CategoryName
                                </span>
                            </a>
                        </div>
                    </div>
                }
            </div>
            <div class="sw-dot-default d-flex d-xl-none tf-sw-pagination"></div>
        </div>
    </div>
</div>
<!-- /Category -->
<!-- Product -->
<div class="flat-spacing pt-0">
    <div class="container">
        <div class="tf-shop-control">
            <div class="tf-control-filter">
                <a href="#filterShop" data-bs-toggle="offcanvas" class="tf-btn-filter h4 link">
                    <span class="icon icon-filter"></span>
                    <span class="text">FILTER</span>
                </a>
                <div class="meta-filter-shop">
                    <!-- <div id="product-count-grid" class="count-text"></div> -->
                    <!-- <div id="product-count-list" class="count-text"></div> -->
                    <div id="applied-filters"></div>
                </div>
            </div>
            <div class="tf-group-layout">
                <ul class="tf-control-layout">
                    <li class="tf-view-layout-switch sw-layout-2 d-none d-md-flex" data-value-layout="tf-col-2">
                        <div class="item icon-grid-2">
                            <span></span>
                            <span></span>
                        </div>
                    </li>
                    <li class="tf-view-layout-switch sw-layout-3 d-none d-md-flex" data-value-layout="tf-col-3">
                        <div class="item icon-grid-3">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </li>
                    <li class="tf-view-layout-switch sw-layout-4 active d-none d-xl-flex" data-value-layout="tf-col-4">
                        <div class="item icon-grid-4">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </li>

                </ul>
                <div class="tf-dropdown-sort" data-bs-toggle="dropdown">
                    <div class="btn-select">
                        <span class="text-sort-value">@(sortBy switch { "price_asc" => "Price, low to high", "price_desc" => "Price, high to low", "name_asc" => "Alphabetically, A-Z", "name_desc" => "Alphabetically, Z-A", "newest" => "Newest", _ => "Best selling" })</span>
                        <span class="icon icon-arrow-angle-down"></span>
                    </div>
                    <div class="dropdown-menu">
                        <a asp-action="Index" asp-route-sortBy="best-selling" class="select-item @(sortBy == "best-selling" || string.IsNullOrEmpty(sortBy) ? "active" : "")">
                            <span class="text-value-item">Best selling</span>
                        </a>
                        <a asp-action="Index" asp-route-sortBy="name_asc" class="select-item @(sortBy == "name_asc" ? "active" : "")">
                            <span class="text-value-item">Alphabetically, A-Z</span>
                        </a>
                        <a asp-action="Index" asp-route-sortBy="name_desc" class="select-item @(sortBy == "name_desc" ? "active" : "")">
                            <span class="text-value-item">Alphabetically, Z-A</span>
                        </a>
                        <a asp-action="Index" asp-route-sortBy="price_asc" class="select-item @(sortBy == "price_asc" ? "active" : "")">
                            <span class="text-value-item">Price, low to high</span>
                        </a>
                        <a asp-action="Index" asp-route-sortBy="price_desc" class="select-item @(sortBy == "price_desc" ? "active" : "")">
                            <span class="text-value-item">Price, high to low</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="wrapper-control-shop gridLayout-wrapper">
            <div class="wrapper-shop tf-grid-layout tf-col-4" id="gridLayout">
                @foreach (var item in Model)
                {
                    <div class="loadItem card_product--V01 grid @(item.Quantity <= 0 ? "out-of-stock" : "")" 
                         data-availability="@(item.Quantity > 0 ? "In stock" : "Out of stock")" 
                         data-category="@item.CategoryId" 
                         data-brand="@item.BrandId">
                        <div class="card_product-wrapper">
                            <a asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="product-img">
                                <img src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/app/images/products/product-1.jpg" : item.PrimaryImageUrl)" 
                                     data-src="@(string.IsNullOrEmpty(item.PrimaryImageUrl) ? "/app/images/products/product-1.jpg" : item.PrimaryImageUrl)" 
                                     alt="@item.ItemName" class="lazyload img-product">
                                @if (!string.IsNullOrEmpty(item.SecondaryImageUrl))
                                {
                                    <img src="@item.SecondaryImageUrl" data-src="@item.SecondaryImageUrl" alt="@item.ItemName" class="lazyload img-hover">
                                }
                            </a>
                            <ul class="list-product-btn">
                                <li class="wishlist">
                                    <a href="javascript:void(0);" class="hover-tooltip tooltip-left box-icon">
                                        <span class="icon icon-heart-2"></span>
                                        <span class="tooltip">Add to Wishlist</span>
                                    </a>
                                </li>
                                @if (item.Quantity > 0)
                                {
                                    <li>
                                        <a href="javascript:void(0);" 
                                           class="hover-tooltip tooltip-left box-icon btn-add-to-cart" 
                                           data-stylecode="@item.StyleCode" 
                                           data-quantity="1">
                                            <span class="icon icon-shop-cart"></span>
                                            <span class="tooltip">Add to Cart</span>
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon quickview" data-stylecode="@item.StyleCode">
                                        <span class="icon icon-view"></span>
                                        <span class="tooltip">Quick View</span>
                                    </a>
                                </li>
                            </ul>
                            @if (item.IsNewLaunch)
                            {
                                <div class="badge-box">
                                    <span class="badge-item new">NEW IN</span>
                                </div>
                            }
                            else if (item.IsOnSale || item.DiscountPercentage > 0)
                            {
                                <div class="badge-box">
                                    <span class="badge-item sale">@(item.DiscountPercentage > 0 ? $"{(int)item.DiscountPercentage}% OFF" : "SALE")</span>
                                </div>
                            }

                            @if (item.Quantity <= 0)
                            {
                                <a href="#unavailable" data-bs-toggle="modal" class="variant-box stock bg-main link text-white">
                                    <p class="text-center d-none d-md-block">Notify Me When Available</p>
                                    <p class="text-center d-md-none">Notify Me</p>
                                </a>
                            }
                        </div>
                        <div class="card_product-info">
                            <a asp-action="ProductDetail" asp-route-id="@item.StyleCode" class="name-product h5 fw-normal link text-line-clamp-2">
                                @item.ItemName
                            </a>
                            <div class="price-wrap">
                                <span class="price-new h5">@item.SellingPrice.ToString("C")</span>
                                @if (item.MRP > item.SellingPrice)
                                {
                                    <span class="price-old fw-normal">@item.MRP.ToString("C")</span>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="wd-full tempo">
                        <div class="wg-show-more">
                            <p>Showing @(((currentPage - 1) * 12) + 1) to @(Math.Min(currentPage * 12, totalItems)) of @totalItems products</p>
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center">
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        var routeData = new Dictionary<string, string>
                                        {
                                            { "page", i.ToString() },
                                            { "sortBy", sortBy ?? "" }
                                        };
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" asp-action="Index" 
                                               asp-all-route-data="routeData"
                                               asp-route-categoryIds="@(string.Join(",", selectedCategoryIds))"
                                               asp-route-brandIds="@(string.Join(",", selectedBrandIds))">@i</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
                else if (totalItems > 0)
                {
                    <div class="wd-full tempo">
                        <div class="wg-show-more">
                            <p>Showing all @totalItems products</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="wd-full tempo text-center">
                        <h4>No products found matching your criteria.</h4>
                        <a asp-action="Index" class="tf-btn fw-medium">CLEAR ALL FILTERS</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- /Product -->

<!-- Filter Sidebar -->
<div class="offcanvas offcanvas-start canvas-sidebar canvas-filter" id="filterShop">
    <div class="canvas-wrapper">
        <div class="canvas-header">
            <span class="title">FILTER</span>
            <span class="icon-close link icon-close-popup" data-bs-dismiss="offcanvas"></span>
        </div>
        <div class="canvas-body">
            <form id="filterForm" asp-action="Index" method="get">
                <input type="hidden" name="sortBy" value="@sortBy" />
                
                <div class="apply-filter-wrap">
                    <p class="title h6 fw-normal text-uppercase">Applied Filters</p>
                    <div id="product-count-grid" class="count-text text-main-4">
                        @if (selectedBrandIds.Any() || selectedCategoryIds.Any())
                        {
                            <span>Filters Applied</span>
                        }
                        else
                        {
                            <span>No Filter Selected</span>
                        }
                    </div>
                    <div class="meta-filter-shop">
                        <div id="applied-filters">
                            @foreach (var brandId in selectedBrandIds)
                            {
                                var brand = brands.FirstOrDefault(b => b.BrandId == brandId);
                                if (brand != null)
                                {
                                    var otherBrands = selectedBrandIds.Where(id => id != brandId).ToList();
                                    <span class="tag">@brand.BrandType 
                                        <a asp-action="Index" 
                                           asp-route-brandIds="@(string.Join(",", otherBrands))"
                                           asp-route-categoryIds="@(string.Join(",", selectedCategoryIds))"
                                           asp-route-sortBy="@sortBy" 
                                           class="icon-close"></a>
                                    </span>
                                }
                            }
                            @foreach (var catId in selectedCategoryIds)
                            {
                                var cat = categories.FirstOrDefault(c => c.CategoryId == catId);
                                if (cat != null)
                                {
                                    var otherCats = selectedCategoryIds.Where(id => id != catId).ToList();
                                    <span class="tag">@cat.CategoryName 
                                        <a asp-action="Index" 
                                           asp-route-categoryIds="@(string.Join(",", otherCats))"
                                           asp-route-brandIds="@(string.Join(",", selectedBrandIds))"
                                           asp-route-sortBy="@sortBy" 
                                           class="icon-close"></a>
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Categories -->
                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#categories" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="categories">
                        <span class="h6 fw-normal text-uppercase">category</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="categories" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var cat in categories)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="categoryIds" value="@cat.CategoryId" class="tf-check style-2" id="cat-@cat.CategoryId" @(selectedCategoryIds.Contains(cat.CategoryId) ? "checked" : "") onchange="this.form.submit()">
                                    <label for="cat-@cat.CategoryId" class="label">
                                        <span>@cat.CategoryName</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Brands -->
                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#brands" role="button" data-bs-toggle="collapse" aria-expanded="true" aria-controls="brands">
                        <span class="h6 fw-normal text-uppercase">Brands</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="brands" class="collapse show">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var brand in brands)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="brandIds" value="@brand.BrandId" class="tf-check style-2" id="brand-@brand.BrandId" @(selectedBrandIds.Contains(brand.BrandId) ? "checked" : "") onchange="this.form.submit()">
                                    <label for="brand-@brand.BrandId" class="label">
                                        <span>@brand.BrandType</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Gold Karats -->
                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#gold-karats" role="button" data-bs-toggle="collapse" aria-expanded="false" aria-controls="gold-karats">
                        <span class="h6 fw-normal text-uppercase">Gold Karat</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="gold-karats" class="collapse">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var karat in goldKarats)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="goldTypeIds" value="@karat.GoldTypeId" class="tf-check style-2" id="karat-@karat.GoldTypeId" onchange="this.form.submit()">
                                    <label for="karat-@karat.GoldTypeId" class="label">
                                        <span>@karat.GoldCarat</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Product Types -->
                <div class="widget-facet">
                    <div class="facet-title h6 fw-normal" data-bs-target="#product-types" role="button" data-bs-toggle="collapse" aria-expanded="false" aria-controls="product-types">
                        <span class="h6 fw-normal text-uppercase">Product Type</span>
                        <span class="icon ic-accordion-custom"></span>
                    </div>
                    <div id="product-types" class="collapse">
                        <ul class="collapse-body filter-group-check current-scrollbar">
                            @foreach (var type in productTypes)
                            {
                                <li class="list-item">
                                    <input type="checkbox" name="productTypeIds" value="@type.ProductTypeId" class="tf-check style-2" id="type-@type.ProductTypeId" onchange="this.form.submit()">
                                    <label for="type-@type.ProductTypeId" class="label">
                                        <span>@type.ProductTypeName</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="canvas-bottom">
                    <button type="submit" class="tf-btn btn-fill animate-btn w-100 justify-content-center">
                        <span>Apply Filters</span>
                    </button>
                    <a asp-action="Index" class="tf-btn btn-outline animate-btn w-100 justify-content-center mt-3">
                        <span>Clear All</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- /Filter Sidebar -->
<!-- Icon Box -->
<div class="flat-spacing-8 bg-main">
    <div class="container">
        <div class="tf-swiper swiper sw-iconbox" data-preview="4" data-tablet="3" data-mobile-sm="2" data-mobile="1" data-space-lg="80"
             data-space-md="30" data-space="15" data-pagination="1" data-pagination-sm="2" data-pagination-md="3" data-pagination-lg="4">
            <div class="swiper-wrapper">
                <!-- item 1 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white">
                        <span class="icon">
                            <i class="icon-box text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">Free Shipping</h4>
                            <p class="text">Enjoy free shipping on all orders</p>
                        </div>
                    </div>
                </div>
                <!-- item 2 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white" data-wow-delay="0.1s">
                        <span class="icon">
                            <i class="icon-credit-card text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">Flexible Payment</h4>
                            <p class="text">Pay with Multiple Credit Cards</p>
                        </div>
                    </div>
                </div>
                <!-- item 3 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white" data-wow-delay="0.2s">
                        <span class="icon">
                            <i class="icon-return text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">14 - Days Return</h4>
                            <p class="text">Free return/exchange within 30 days</p>
                        </div>
                    </div>
                </div>
                <!-- item 4 -->
                <div class="swiper-slide">
                    <div class="box_icon--V01 style-white" data-wow-delay="0.3s">
                        <span class="icon">
                            <i class="icon-headphone text-primary"></i>
                        </span>
                        <div class="content">
                            <h4 class="title">Premium Support</h4>
                            <p class="text">Enjoy our premium support</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sw-dot-default style-white tf-sw-pagination"></div>
        </div>
    </div>
</div>
<!-- /Icon Box -->
