@model IEnumerable<Yash_Gems___Jewelleries.Models.Order>
@{
	ViewData["Title"] = "My Orders";
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a href="index-2.html" class="text-main-4 link-secondary">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>Account</li>
                </ul>
                <h1 class="heading fw-normal text-uppercase">
                    my account
                </h1>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->
<!-- Account -->
<div class="flat-spacing">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="sidebar-account-wrap sidebar-content-wrap sticky-top d-lg-block d-none">
                    <ul class="my-account-nav">
                        <li>
                            <a asp-action="Index" asp-controller="Account" class="link-account ">
                                <span class="text">Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Order" asp-controller="Account" class="link-account active">
                                <span class="text">My Orders</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Wishlist" asp-controller="Account" class="link-account">
                                <span class="text">My Wishlist</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Inquiries" asp-controller="Account" class="link-account">
                                <span class="text">Inquiries</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Detail" asp-controller="Account" class="link-account">
                                <span class="text">Detail</span>
                            </a>
                        </li>
                        <li>
                            <form id="logoutFormSidebar" method="post" action="/Account/Logout" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/" />
                            </form>
                            <a href="javascript:void(0)" onclick="document.getElementById('logoutFormSidebar').submit()" class="link-account">
                                <span class="text">Log Out</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="my-acount-content account-order">
                    <h4 class="heading fw-normal">
                        Order History
                    </h4>
                    @if(Model != null && Model.Any())
                    {
                        <div class="table-order-history">
                            <table>
                                <thead>
                                    <tr>
                                        <th class="title-case order_code">ORDER ID</th>
                                    <th class="title-case order_date">ORDER DATE</th>
                                    <th class="title-case order_status">STATUS</th>
                                    <th class="title-case order_total">TOTAL</th>
                                    <th class="title-case order_action">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in Model)
                                {
                                    <tr>
                                        <td>#@item.OrderNumber</td>
                                        <td>@item.OrderDate.ToString("MMM dd, yyyy")</td>
                                        <td>@item.OrderStatus</td>
                                        <td>@item.TotalAmount.ToString("C")</td>
                                        <td>
                                        <a href="#orderDetail" data-bs-toggle="modal" data-order-id="@item.OrderId" class="btn-action link">
                                            <i class="icon icon-view-2"></i>
                                        </a>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                    else
                    {
                    <div class="col-lg-8 d-flex justify-content-center">
                        <div class="my-acount-content account-order empty">
                            <div class="ic-img">
                                <img src="/app/images/section/empty-cart.svg" alt="Emty Cart">
                            </div>
                            <p class="title text-lg-2">You haven’t placed any order yet</p>
                            <p class="sub-title">It’s time to make your first order</p>
                            <a asp-action="Index" asp-controller="Shop" class="tf-btn fw-medium btn-out-line">
                                SHOPPING
                            </a>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Account -->
<!-- Order Detail -->
<div class="modal modalCentered fade modal-order-detail" id="orderDetail" tabindex="-1" aria-hidden="true">
    <!-- Content loaded via AJAX -->
</div>
<!-- /Order Detail -->

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-action.link').on('click', function (e) {
                e.preventDefault();
                var orderId = $(this).data('order-id');

                // Show loading state or clear previous content
                $('#orderDetail').html('<div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div></div></div>');
                
                // Show modal
                var myModal = new bootstrap.Modal(document.getElementById('orderDetail'));
                myModal.show();

                $.ajax({
                    url: '@Url.Action("GetOrderDetail", "Account")',
                    type: 'GET',
                    data: { id: orderId },
                    success: function (result) {
                        $('#orderDetail').html(result);
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                        $('#orderDetail').html('<div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body text-center py-5"><h5 class="text-danger">Failed to load order details.</h5></div></div></div></div>');
                    }
                });
            });
        });
    </script>
}