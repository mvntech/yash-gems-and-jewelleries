@model IEnumerable<Yash_Gems___Jewelleries.Models.Inquiry>
@{
    ViewData["Title"] = "My Inquiries";
}

<!-- Page Title -->
<section class="flat-spacing-2 pb-0">
    <div class="container">
        <div class="page-title">
            <div class="breadcrumbs">
                <ul class="bread-wrap">
                    <li><a asp-action="Index" asp-controller="Home" class="text-main-4 link-secondary">Home</a></li>
                    <li class="br-line w-12 bg-main"></li>
                    <li>Account</li>
                </ul>
                <h1 class="heading fw-normal text-uppercase">
                    my account
                </h1>
            </div>
        </div>
    </div>
</section>
<!-- /Page Title -->

<!-- Account -->
<div class="flat-spacing">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="sidebar-account-wrap sidebar-content-wrap sticky-top d-lg-block d-none">
                    <ul class="my-account-nav">
                        <li>
                            <a asp-action="Index" asp-controller="Account" class="link-account">
                                <span class="text">Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Order" asp-controller="Account" class="link-account">
                                <span class="text">My Orders</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Wishlist" asp-controller="Account" class="link-account">
                                <span class="text">My Wishlist</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Inquiries" asp-controller="Account" class="link-account">
                                <span class="text">Inquiries</span>
                            </a>
                        </li>
                        <li>
                            <a asp-action="Detail" asp-controller="Account" class="link-account">
                                <span class="text">Detail</span>
                            </a>
                        </li>
                        <li>
                            <form id="logoutFormSidebar" method="post" action="/Account/Logout" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/" />
                            </form>
                            <a href="javascript:void(0)" onclick="document.getElementById('logoutFormSidebar').submit()" class="link-account">
                                <span class="text">Log Out</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="my-acount-content account-order">
                    <h4 class="heading fw-normal">
                        My Inquiries
                    </h4>
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            You haven't submitted any inquiries yet. 
                            <a asp-action="ContactUs" asp-controller="Home" class="text-decoration-underline text-primary">Need help? Contact us!</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-order-history">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th class="title-case">DATE</th>
                                        <th class="title-case">SUBJECT</th>
                                        <th class="title-case">STATUS</th>
                                        <th class="title-case">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inquiry in Model)
                                    {
                                        <tr>
                                            <td>@inquiry.CreatedDate.ToString("dd MMM yyyy")</td>
                                            <td>@inquiry.Subject</td>
                                            <td>
                                                @{
                                                    var statusClass = inquiry.Status switch
                                                    {
                                                        "New" => "text-primary",
                                                        "Pending" => "text-warning",
                                                        "Resolved" => "text-success",
                                                        "Closed" => "text-muted",
                                                        _ => ""
                                                    };
                                                }
                                                <span class="@statusClass fw-bold">@inquiry.Status</span>
                                            </td>
                                            <td>
                                                <a href="#inquiryDetail-@inquiry.InquiryId" data-bs-toggle="modal" class="btn-action link">
                                                    <i class="icon icon-view-2"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@foreach (var inquiry in Model)
{
    <!-- Inquiry Detail Modal -->
    <div class="modal modalCentered fade modal-order-detail" id="inquiryDetail-@inquiry.InquiryId">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <span class="icon-close-popup" data-bs-dismiss="modal">
                    <i class="icon-close"></i>
                </span>
                <div class="modal-top">
                    <h3 class="title fw-normal text-uppercase">Inquiry Detail</h3>
                </div>
                <div class="modal-body">
                    <ul class="list-infor">
                        <li><strong>Subject:</strong> @inquiry.Subject</li>
                        <li class="br-line"></li>
                        <li><strong>Date:</strong> @inquiry.CreatedDate.ToString("dd MMM yyyy HH:mm")</li>
                        <li class="br-line"></li>
                        <li><strong>Status:</strong> <span class="text-uppercase fw-bold">@inquiry.Status</span></li>
                    </ul>
                    <div class="mt-4 p-3 bg-light rounded">
                        <p class="mb-2 text-muted uppercase small">Your Message:</p>
                        <p class="mb-0">@inquiry.Message</p>
                    </div>

                    @if (!string.IsNullOrEmpty(inquiry.AdminResponse))
                    {
                        <div class="mt-4 p-3 border border-success rounded bg-success-subtle bg-opacity-10">
                            <p class="mb-2 text-success uppercase small">Admin Response (@(inquiry.ResponseDate?.ToString("dd MMM yyyy") ?? "")):</p>
                            <p class="mb-0">@inquiry.AdminResponse</p>
                        </div>
                    }
                    else
                    {
                        <div class="mt-4 p-3 border border-warning rounded bg-warning-subtle bg-opacity-10">
                            <p class="mb-0 text-muted italic">Our team is reviewing your inquiry. We will respond shortly.</p>
                        </div>
                    }

                    @if (inquiry.Item != null)
                    {
                        <div class="mt-4 p-3 border rounded">
                            <p class="mb-2 text-muted uppercase small">Related Product:</p>
                            <div class="d-flex align-items-center">
                                <img src="@inquiry.Item.PrimaryImageUrl" alt="@inquiry.Item.ItemName" style="width: 50px; height: 50px; object-fit: cover;" class="me-3 rounded">
                                <div>
                                    <h6 class="mb-0">@inquiry.Item.ItemName</h6>
                                    <small class="text-muted">Style Code: @inquiry.StyleCode</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
